# Variables de entorno para el frontend
# Copia este archivo a .env.local y ajusta los valores según tu entorno

# =============================================================================
# CONFIGURACIÓN BÁSICA
# =============================================================================

# URL base de la API del backend
VITE_API_BASE_URL=http://localhost:8000

# Entorno de la aplicación
VITE_NODE_ENV=development

# Nombre de la aplicación
VITE_APP_NAME=Quantitative Analysis Finance

# =============================================================================
# FUNCIONALIDADES
# =============================================================================

# Habilitar modo debug
VITE_ENABLE_DEBUG_MODE=true

# Habilitar analytics
VITE_ENABLE_ANALYTICS=false

# =============================================================================
# INTERFAZ DE USUARIO
# =============================================================================

# Tema por defecto (light, dark)
VITE_THEME=light

# Idioma por defecto (es, en)
VITE_LANGUAGE=es

# =============================================================================
# SERVICIOS EXTERNOS (OPCIONALES)
# =============================================================================

# Clave de API para Yahoo Finance
VITE_YAHOO_FINANCE_API_KEY=

# Clave de API para Alpha Vantage
VITE_ALPHA_VANTAGE_API_KEY=

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================

# 1. Todas las variables deben comenzar con VITE_
# 2. Reinicia el servidor después de modificar este archivo
# 3. Nunca committear .env.local al repositorio
